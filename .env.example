# Configuración de PostgreSQL
# En docker compose, POSTGRES_HOST debe ser "postgres" (nombre del servicio).
# Para correr la app fuera de Docker, usa "localhost".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ctt_db
POSTGRES_USER=ctt_app
POSTGRES_PASSWORD=CambiaEstaClave

# Configuración JWT
JWT_SECRET_KEY=tu_clave_secreta_jwt_muy_segura

# Debug
DEBUG=True

# URL del Backend (para URLs completas de imágenes)
BACKEND_URL=http://localhost:8000
